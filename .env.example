# Digi Seva Solution Backend - Environment Variables Template
#
# Copy this file to '.env' in the project root:
#   cp .env.example .env
# Fill in your actual Neon PostgreSQL, Resend, and Cloudinary credentials.

# Application Environment
SPRING_PROFILES_ACTIVE=dev
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (Neon PostgreSQL)
DB_URL=jdbc:postgresql://ep-xxxx.us-east-2.aws.neon.tech/digiseva_db?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password_here

# JWT Configuration
JWT_SECRET=your_256_bit_jwt_secret_key_here_min_32_chars
JWT_EXPIRATION_MS=86400000

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Cloudinary Integration Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
